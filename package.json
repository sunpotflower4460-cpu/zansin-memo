{
  "name": "kizashi-notes",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:ios": "npx --yes eas-cli@27.11.0 build --platform ios --profile production",
    "submit:ios": "npx --yes eas-cli@27.11.0 submit --platform ios --profile production",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev",
    "measure:store": "node --import tsx scripts/measure-store.ts",
    "measure:plus-storage": "node --import tsx scripts/measure-plus-storage.ts",
    "measure:logic": "node --import tsx scripts/measure-logic.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "html-to-image": "^1.11.13",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.1.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.60.1",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "@expo/metro-config": {
      "postcss": "8.5.34"
    }
  },
  "private": true
}
