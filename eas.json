      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_KIZASHI_PLUS_COMPARISON": "0"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "comparison": {
