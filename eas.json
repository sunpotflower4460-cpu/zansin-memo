      "env": {
        "EXPO_PUBLIC_KIZASHI_PLUS_COMPARISON": "1"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
